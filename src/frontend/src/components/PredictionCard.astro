---
import { getTexturePath } from '../utils/textures.js';
import InfoTooltip from './InfoTooltip.astro';
import AssociatedGear from './AssociatedGear.astro';

const { bot, baseUrl = '', oddsLabel = 'likely', oddsTooltip = null, rank = null, hit = null } = Astro.props;
// `hit` is only passed on the /history page (graded snapshots); left null on the
// live predictions page, where a pick has no outcome yet.

const iconSrc = getTexturePath(bot.icon_path, baseUrl);
const itemsHref = bot.items_anchor ? `${baseUrl}items#${bot.items_anchor}` : `${baseUrl}items`;
const avgText =
	bot.avg_interval == null ? 'not enough history' : `avg ${bot.avg_interval} wks`;
---

<li class:list={["prediction-card", { "is-hit": hit === true, "is-miss": hit === false }]}>
	<div class="prediction-card__main">
		{rank != null && <span class="prediction-card__rank" aria-hidden="true">{rank}</span>}
		{hit !== null && (
			<span class:list={["prediction-card__result", hit ? "is-hit" : "is-miss"]}
				title={hit ? "Discounted this week" : "Not discounted"}
				aria-label={hit ? "Discounted this week" : "Not discounted"}>
				{hit ? (
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				) : (
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				)}
			</span>
		)}
		<a class="prediction-card__identity" href={itemsHref}>
			<span class="prediction-card__icon">
				{iconSrc && <img src={iconSrc} alt={bot.name} loading="lazy" />}
			</span>
			<span class="prediction-card__body">
				<span class="prediction-card__name">{bot.name}</span>
				<span class="prediction-card__meta">
					{bot.weeks_since_discount} wks since last discount &middot; {avgText}
				</span>
			</span>
		</a>
		<div class="prediction-card__odds">
			{bot.likelihood_pct != null ? (
				<>
					<span class="prediction-card__pct">{bot.likelihood_pct}%</span>
					<span class="prediction-card__pct-label">
						{oddsLabel}
						{oddsTooltip && <InfoTooltip text={oddsTooltip} label="Why this percentage" />}
					</span>
				</>
			) : (
				<>
					<span class="prediction-card__pct prediction-card__pct--na">&mdash;</span>
					<span class="prediction-card__pct-label">
						no estimate
						<InfoTooltip text="Too little history before this week to estimate odds. The pick is still the most overdue robot, and it is graded normally." label="Why no percentage" />
					</span>
				</>
			)}
		</div>
	</div>

	<AssociatedGear items={bot.associated} baseUrl={baseUrl} />
</li>

<style>
	.prediction-card {
		display: flex;
		flex-direction: column;
		padding: 0.7rem 1rem;
		background: rgba(22, 25, 32, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
	}

	.prediction-card__main {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.prediction-card__rank {
		flex-shrink: 0;
		width: 1.4rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--wrf-text-muted);
		text-align: center;
	}

	.prediction-card__identity {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex: 1;
		min-width: 0;
		text-decoration: none;
		color: inherit;
		border-bottom: none;
	}

	.prediction-card__identity:hover {
		border-bottom: none;
	}

	.prediction-card__identity:hover .prediction-card__name {
		color: var(--wrf-accent);
	}

	.prediction-card__icon {
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.prediction-card__icon img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	.prediction-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.prediction-card__name {
		font-weight: 600;
		font-size: 1rem;
		color: var(--wrf-text);
		transition: color 0.15s ease;
	}

	.prediction-card__meta {
		font-size: 0.78rem;
		color: var(--wrf-text-muted);
	}

	.prediction-card__odds {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		line-height: 1.1;
	}

	.prediction-card__pct {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--wrf-accent);
	}

	.prediction-card__pct--na {
		color: var(--wrf-text-muted);
	}

	.prediction-card__pct-label {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.4px;
		color: var(--wrf-text-muted);
	}

	/* Graded snapshots (/history) only: a discounted pick reads green, a missed
	   one is dimmed. Live predictions pass no `hit`, so neither applies. */
	.prediction-card.is-hit {
		border-color: rgba(46, 196, 182, 0.5);
		background: rgba(46, 196, 182, 0.08);
	}

	.prediction-card.is-miss {
		opacity: 0.62;
	}

	.prediction-card__result {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
	}

	.prediction-card__result.is-hit {
		color: #2ec4b6;
		background: rgba(46, 196, 182, 0.15);
	}

	.prediction-card__result.is-miss {
		color: var(--wrf-text-muted);
		background: rgba(139, 146, 165, 0.12);
	}
</style>
