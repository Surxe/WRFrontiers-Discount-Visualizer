---
import { getCurrencyIconUrl } from '../utils/textures.js';
import WeeklyIncome from './WeeklyIncome.astro';
import CalcHeader from './CalcHeader.astro';

const { searchableModules = [], rarityUpgradeCosts = {}, discountSchedule = {}, weekList = [], currentWeekSlug = null } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '/';
---
<aside id="cost-calculator-drawer" class="calculator-drawer">
  <CalcHeader />
  <div class="calculator-content">
    <div class="search-container">
      <input type="text" id="module-search-input" placeholder="Search for a module to add..." autocomplete="off" />
      <ul id="module-search-results" class="search-results"></ul>
    </div>

    <div id="calculator-empty-state" class="empty-state">
      Click the + on any module to start calculating
    </div>
    <table id="calculator-table" class="calculator-table" style="display: none;">
      <thead>
        <tr>
          <th>Module</th>
          <th>Qty</th>
          <th>From</th>
          <th>To</th>
          <th>Disc?</th>
          <th class="currency-header"><img src={getCurrencyIconUrl('salvage', baseUrl)} alt="Salvage" class="header-currency-icon" /> Salvage</th>
          <th class="currency-header"><img src={getCurrencyIconUrl('intel', baseUrl)} alt="Intel" class="header-currency-icon" /> Intel</th>
        </tr>
      </thead>
      <tbody id="calculator-tbody">
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" class="total-label">Discounted Total:</td>
          <td></td>
          <td id="calc-total-salvage">-</td>
          <td id="calc-total-intel">-</td>
        </tr>
        <tr id="calc-discount-row" style="display: none;">
          <td colspan="4" class="total-label discount-label">Discount:</td>
          <td></td>
          <td id="calc-discount-salvage" class="discount-val">-</td>
          <td id="calc-discount-intel" class="discount-val">-</td>
        </tr>
        <tr id="calc-discount-pct-row" style="display: none;">
          <td colspan="4" class="total-label discount-label">Discount %:</td>
          <td></td>
          <td id="calc-discount-pct-salvage" class="discount-pct">-</td>
          <td id="calc-discount-pct-intel" class="discount-pct">-</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <WeeklyIncome />
</aside>

<style>
  .calculator-drawer {
    position: fixed;
    top: 0;
    right: -500px;
    width: 500px;
    max-width: 100%;
    height: 100vh;
    background-color: var(--wrf-surface);
    border-left: 1px solid var(--wrf-border);
    z-index: 9999;
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
    box-shadow: -5px 0 15px rgba(0,0,0,0.5);
    box-sizing: border-box;
  }

  .calculator-drawer.is-open {
    right: 0;
  }

  @media (max-width: 768px) {
    .calculator-drawer {
      width: 100%;
      right: -100%;
    }

    /* Size the item list to its content so the Weekly income panel sits directly
       under the table instead of being pinned to the bottom behind a big empty
       gap. When many items are added the list still scrolls internally. The
       two-class selector outranks the base `.calculator-content { flex: 1 }`
       defined later in this stylesheet. */
    .calculator-drawer .calculator-content {
      flex: 0 1 auto;
    }

    :global(.calculator-table .qty-btn) {
      width: 28px;
      height: 28px;
    }
  }


  .calculator-content {
    overflow-y: auto;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .empty-state {
    text-align: center;
    color: var(--wrf-text-muted);
    margin-top: 2rem;
    font-style: italic;
    padding: 1rem;
  }

  .calculator-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .calculator-table th {
    padding: 0.4rem 0.3rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
  }

  :global(.calculator-table td) {
    padding: 0.4rem 0.3rem;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
  }

  .calculator-table th {
    color: var(--wrf-text-muted);
    font-weight: normal;
    font-size: 0.75rem;
    position: sticky;
    top: 0;
    background: var(--wrf-surface);
    z-index: 1;
  }

  .calculator-table th:first-child {
    text-align: left;
    padding-left: 1rem;
  }

  .calculator-table th.currency-header {
    white-space: nowrap;
  }
  
  .header-currency-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    vertical-align: text-bottom;
    margin-right: 2px;
  }

  :global(.calculator-table td.module-col) {
    text-align: left;
    padding-left: 1rem;
  }

  :global(.module-col-inner) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
  }

  :global(.module-col-name) {
    font-size: 0.8rem;
    line-height: 1.2;
    overflow: hidden;
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  :global(.calc-icon-wrapper) {
    width: 32px;
    height: 48px;
    flex-shrink: 0;
  }

  :global(.qty-col) {
    white-space: nowrap;
  }

  :global(.qty-btn) {
    background: var(--wrf-surface-2);
    border: none;
    color: var(--wrf-text);
    cursor: pointer;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    margin: 0 1px;
    line-height: 1;
  }

  :global(.qty-btn:hover) {
    background: var(--wrf-border);
  }

  :global(.level-select) {
    background: var(--wrf-border);
    border: 1px solid var(--wrf-surface-2);
    color: var(--wrf-text);
    border-radius: 3px;
    padding: 1px 2px;
    font-size: 0.75rem;
    width: 44px;
    outline: none;
    cursor: pointer;
  }

  :global(.cost-cell) {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    color: var(--wrf-text);
  }

  :global(.disc-yes) {
    color: #4caf50;
    font-weight: 600;
  }

  :global(.disc-no) {
    color: var(--wrf-text-muted);
  }

  :global(.disc-none) {
    color: var(--wrf-border);
  }

  :global(.disc-toggle-btn) {
    border-radius: 4px;
    cursor: pointer;
    padding: 2px 7px;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.4;
    transition: background 0.15s, border-color 0.15s, opacity 0.15s;
  }

  :global(.disc-toggle-btn.disc-yes) {
    background: rgba(76, 175, 80, 0.18);
    border: 1px solid rgba(76, 175, 80, 0.45);
  }

  :global(.disc-toggle-btn.disc-yes:hover) {
    background: rgba(76, 175, 80, 0.30);
    border-color: rgba(76, 175, 80, 0.7);
  }

  :global(.disc-toggle-btn.disc-no) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  :global(.disc-toggle-btn.disc-no:hover) {
    background: rgba(255, 255, 255, 0.10);
    border-color: rgba(255, 255, 255, 0.25);
  }

  :global(.total-label) {
    text-align: right;
    font-weight: bold;
    font-size: 0.8rem;
    color: var(--wrf-text-muted);
  }

  :global(.discount-label) {
    color: #4caf50;
    font-size: 0.75rem;
  }

  :global(.discount-val) {
    color: #4caf50;
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
  }

  :global(.discount-pct) {
    color: #4caf50;
    font-size: 0.7rem;
    font-weight: bold;
  }

  #calc-total-salvage,
  #calc-total-intel {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    color: var(--wrf-text);
  }

  /* Search Styles */
  .search-container {
    padding: 1rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }

  #module-search-input {
    width: 100%;
    padding: 10px 12px;
    background: var(--wrf-bg);
    border: 1px solid var(--wrf-surface-2);
    color: var(--wrf-text);
    border-radius: 4px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }

  #module-search-input:focus {
    border-color: var(--wrf-border);
  }

  .search-results {
    position: absolute;
    top: calc(100% - 1rem);
    left: 1rem;
    right: 1rem;
    background: #1a1e27;
    border: 1px solid var(--wrf-surface-2);
    border-top: none;
    border-radius: 0 0 6px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    max-height: 400px;
    overflow-y: auto;
    z-index: 10;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
    display: none;
  }

  .search-results.active {
    display: block;
  }

  :global(.search-result-item) {
    padding: 8px 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.02);
    transition: background 0.15s;
  }

  :global(.search-result-item:hover) {
    background: rgba(255,255,255,0.05);
  }

  :global(.search-result-name) {
    font-size: 0.9rem;
    color: var(--wrf-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-result-icon) {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.search-result-icon img) {
    width: 90%;
    height: 90%;
    object-fit: contain;
    transform: scale(1.1);
  }

  @media (max-width: 480px) {
    /* ---- Card layout ----------------------------------------------------
       On phones the 7-column table can't hold every control at a usable size,
       so each item becomes a stacked "card": the module name spans the top,
       and Qty / From / To / Disc / costs flow underneath with pseudo-labels
       (the header row is hidden). This keeps the per-item discount toggle
       reachable — previously the whole Disc column was hidden here. */
    .calculator-table thead {
      display: none;
    }

    .calculator-table,
    .calculator-table tbody,
    .calculator-table tfoot {
      display: block;
      width: 100%;
    }

    :global(.calculator-table tbody tr) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.6rem;
      padding: 0.6rem 0.15rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    :global(.calculator-table tbody td) {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0;
      border: none;
      text-align: left;
      font-size: 0.82rem;
    }

    /* Module name + icon: full-width card header. */
    :global(.calculator-table td.module-col) {
      flex: 1 1 100%;
      padding-left: 0;
    }

    :global(.module-col-name) {
      -webkit-line-clamp: 1;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* Pseudo-labels stand in for the hidden header row. */
    :global(.calculator-table tbody td[data-label]::before) {
      content: attr(data-label);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--wrf-text-muted);
    }

    /* Costs share their own line, pushed after the controls. */
    :global(.calculator-table td.cost-cell) {
      flex: 1 1 42%;
      font-size: 0.85rem;
    }

    /* Totals footer as simple label / value rows. */
    :global(.calculator-table tfoot tr) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.15rem;
    }

    :global(.calculator-table tfoot td) {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0;
      border: none;
    }

    :global(.calculator-table tfoot td:empty) {
      display: none;
    }

    :global(.total-label) {
      text-align: left;
    }

    :global(.search-result-icon) {
      width: 28px;
      height: 28px;
    }

    /* Larger, thumb-friendly controls. */
    :global(.qty-btn) {
      width: 30px;
      height: 30px;
      font-size: 1.1rem;
    }

    :global(.qty-col) {
      font-size: 0.82rem;
    }

    :global(.level-select) {
      min-height: 34px;
      min-width: 48px;
      padding: 2px 4px;
      font-size: 0.85rem;
    }

    :global(.disc-toggle-btn) {
      min-width: 36px;
      min-height: 32px;
      font-size: 1rem;
    }
  }

</style>

<script is:inline define:vars={{ searchableModules, rarityUpgradeCosts, discountSchedule, weekList, currentWeekSlug }}>
  // Embed all calc data globally
  window.WRF_CALC_DATA = searchableModules;
  window.WRF_CALC_META = { rarityUpgradeCosts, discountSchedule };

  // Populate week select
  const weekSelect = document.getElementById('calc-week-select');
  weekList.forEach(w => {
    const opt = document.createElement('option');
    opt.value = w.slug;
    opt.textContent = w.label;
    if (w.slug === currentWeekSlug) opt.selected = true;
    weekSelect.appendChild(opt);
  });
</script>

<script>
  import { calculatorStore, CREDIT_SALVAGE_PRESETS, JOB_SEEDS } from '../scripts/cost-calculator-store.js';

  const drawer = document.getElementById('cost-calculator-drawer');
  const closeBtn = document.getElementById('close-calculator');
  const clearBtn = document.getElementById('clear-calculator');
  const weekSelect = document.getElementById('calc-week-select');
  const emptyState = document.getElementById('calculator-empty-state');
  const table = document.getElementById('calculator-table');
  const tbody = document.getElementById('calculator-tbody');
  const totalSalvageEl = document.getElementById('calc-total-salvage');
  const totalIntelEl = document.getElementById('calc-total-intel');
  const searchInput = document.getElementById('module-search-input');
  const searchResults = document.getElementById('module-search-results');
  const incomeImpactEl = document.getElementById('income-impact');
  const incomePremiumGamesEl = document.getElementById('income-premium-games');
  const incomeFreeGamesEl = document.getElementById('income-free-games');
  const incomeDailiesEl = document.getElementById('income-dailies');
  const incomeWeeklyJobsEl = document.getElementById('income-weekly-jobs');
  const incomeRateEl = document.getElementById('income-rate');
  const incomeRateSelectEl = document.getElementById('income-rate-select');
  const incomeSeedFreeEl = document.getElementById('income-seed-free');
  const incomeSeedPremiumEl = document.getElementById('income-seed-premium');
  const incomeJobsSalvageEl = document.getElementById('income-jobs-salvage');
  const incomeJobsIntelEl = document.getElementById('income-jobs-intel');
  const incomeMatchesSalvageEl = document.getElementById('income-matches-salvage');
  const incomeTotalSalvageEl = document.getElementById('income-total-salvage');
  const incomeTotalIntelEl = document.getElementById('income-total-intel');

  // --- Weekly income inputs ---
  // Hydrate from persisted store state, then push edits back to the store.
  incomeImpactEl.value = calculatorStore.income.avgImpact || '';
  incomePremiumGamesEl.value = calculatorStore.income.premiumGames ?? '';
  incomeFreeGamesEl.value = calculatorStore.income.freeGames ?? '';
  incomeDailiesEl.value = calculatorStore.income.dailiesPerWeek ?? '';
  incomeWeeklyJobsEl.value = calculatorStore.income.weeklyJobsPerWeek ?? '';

  // Credit -> salvage rate: a dropdown of preset bundles plus a "Custom rate"
  // option. The number box only appears for Custom, so presets don't crowd it.
  const fmtK = (n) => (n % 1000 === 0 ? `${n / 1000}k` : n.toLocaleString());
  incomeRateSelectEl.innerHTML =
    CREDIT_SALVAGE_PRESETS.map((p) =>
      `<option value="${p.rate}">${p.rate} · ${fmtK(p.credits)}→${fmtK(p.salvage)}</option>`
    ).join('') +
    '<option value="custom">Custom salvage/credits…</option>';

  // Reflect a stored rate into the dropdown + (conditionally shown) custom box:
  // an exact preset match selects that preset; anything else is a custom average.
  function reflectRate(rate) {
    // findLast so a rate shared by two bundles (10 = 6k→60k and 9k→90k) resolves
    // to the larger bundle, making 9k→90k the default shown for the default rate.
    const preset = CREDIT_SALVAGE_PRESETS.findLast((p) => Number(p.rate) === Number(rate));
    if (preset) {
      incomeRateSelectEl.value = String(preset.rate);
      incomeRateEl.hidden = true;
    } else {
      incomeRateSelectEl.value = 'custom';
      incomeRateEl.hidden = false;
      incomeRateEl.value = rate ?? '';
    }
  }
  reflectRate(calculatorStore.income.creditToSalvage);

  incomeImpactEl.addEventListener('input', () => {
    calculatorStore.setIncome({ avgImpact: incomeImpactEl.value });
  });
  incomePremiumGamesEl.addEventListener('input', () => {
    calculatorStore.setIncome({ premiumGames: incomePremiumGamesEl.value });
  });
  incomeFreeGamesEl.addEventListener('input', () => {
    calculatorStore.setIncome({ freeGames: incomeFreeGamesEl.value });
  });
  incomeDailiesEl.addEventListener('input', () => {
    calculatorStore.setIncome({ dailiesPerWeek: incomeDailiesEl.value });
  });
  incomeWeeklyJobsEl.addEventListener('input', () => {
    calculatorStore.setIncome({ weeklyJobsPerWeek: incomeWeeklyJobsEl.value });
  });
  incomeRateEl.addEventListener('input', () => {
    calculatorStore.setIncome({ creditToSalvage: incomeRateEl.value });
  });

  // Seed buttons prefill a full free/premium week: the (uncapped) job counts,
  // and the games split — the current games total moves entirely into the tier's
  // bucket (Premium week -> all premium, Free week -> all free), keeping volume.
  function applyWeek(tier) {
    const seed = JOB_SEEDS[tier];
    const totalGames = (Number(calculatorStore.income.premiumGames) || 0)
                     + (Number(calculatorStore.income.freeGames) || 0);
    const premiumGames = tier === 'premium' ? totalGames : 0;
    const freeGames = tier === 'premium' ? 0 : totalGames;
    incomeDailiesEl.value = seed.dailiesPerWeek;
    incomeWeeklyJobsEl.value = seed.weeklyJobsPerWeek;
    incomePremiumGamesEl.value = premiumGames;
    incomeFreeGamesEl.value = freeGames;
    calculatorStore.setIncome({ ...seed, premiumGames, freeGames });
  }
  incomeSeedFreeEl.addEventListener('click', () => applyWeek('free'));
  incomeSeedPremiumEl.addEventListener('click', () => applyWeek('premium'));

  // --- Weekly income collapse: remember open/closed across page loads ---
  const incomeDetails = document.getElementById('income-details');
  if (incomeDetails) {
    try {
      const saved = localStorage.getItem('wrf-income-open');
      if (saved === 'false') incomeDetails.open = false;
      else if (saved === 'true') incomeDetails.open = true;
    } catch (e) {}
    incomeDetails.addEventListener('toggle', () => {
      try { localStorage.setItem('wrf-income-open', String(incomeDetails.open)); } catch (e) {}
    });
  }

  // Choosing "Custom rate" reveals the number box; choosing a preset hides it
  // and applies that rate directly.
  incomeRateSelectEl.addEventListener('change', () => {
    if (incomeRateSelectEl.value === 'custom') {
      incomeRateEl.hidden = false;
      incomeRateEl.focus();
      calculatorStore.setIncome({ creditToSalvage: incomeRateEl.value });
    } else {
      incomeRateEl.hidden = true;
      calculatorStore.setIncome({ creditToSalvage: incomeRateSelectEl.value });
    }
  });

  // --- Week Select ---
  // Sync store with current page week on first load if not already set
  if (!calculatorStore.activeWeek && weekSelect.value) {
    calculatorStore.activeWeek = weekSelect.value || null;
  } else if (calculatorStore.activeWeek) {
    weekSelect.value = calculatorStore.activeWeek;
  }

  weekSelect.addEventListener('change', () => {
    calculatorStore.setActiveWeek(weekSelect.value || null);
  });

  // --- Search Logic ---
  searchInput.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      searchResults.classList.remove('active');
      return;
    }

    const matches = (window.WRF_CALC_DATA || []).filter(m => m.name.toLowerCase().includes(query)).slice(0, 10);

    if (matches.length > 0) {
      searchResults.innerHTML = matches.map(m => `
        <li class="search-result-item" data-module-id="${m.id}" data-module-name="${m.name}" data-module-icon="${m.iconSrc}" data-module-bg="${m.bgSrc}" data-module-rarity="${m.rarityRef}">
          <div class="search-result-icon" style="background-image: url('${m.bgSrc}');">
            <img src="${m.iconSrc}" alt="${m.name}" />
          </div>
          <span class="search-result-name">${m.name}</span>
        </li>
      `).join('');
      searchResults.classList.add('active');
    } else {
      searchResults.classList.remove('active');
    }
  });

  searchResults.addEventListener('click', (e) => {
    const item = e.target.closest('.search-result-item');
    if (!item) return;

    calculatorStore.addItem({
      id: item.dataset.moduleId,
      name: item.dataset.moduleName,
      iconSrc: item.dataset.moduleIcon,
      bgSrc: item.dataset.moduleBg,
      rarityRef: item.dataset.moduleRarity,
    });

    searchInput.value = '';
    searchResults.classList.remove('active');
  });

  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
      searchResults.classList.remove('active');
    }
  });

  // --- Help tooltip: tap-to-toggle on touch devices ---
  // The "?" tooltips are hover-only in CSS, which never fires on touch. Tapping
  // the icon toggles a `.tooltip-open` class on its wrapper; tapping elsewhere
  // dismisses it. Hover still works unchanged on pointer devices.
  document.addEventListener('click', (e) => {
    const icon = e.target.closest('.tooltip-icon');
    const openWrap = icon ? icon.closest('.header-with-tooltip') : null;
    document.querySelectorAll('.header-with-tooltip.tooltip-open').forEach((w) => {
      if (w !== openWrap) w.classList.remove('tooltip-open');
    });
    if (openWrap) {
      e.stopPropagation();
      openWrap.classList.toggle('tooltip-open');
    }
  });

  // --- Level select builder helpers ---
  function makeLevelSelect(name, selectedVal, min, max, instanceId) {
    let opts = '';
    for (let i = min; i <= max; i++) {
      opts += `<option value="${i}"${i === selectedVal ? ' selected' : ''}>${i}</option>`;
    }
    return `<select class="level-select" data-lvl-type="${name}" data-id="${instanceId}">${opts}</select>`;
  }

  // --- Render ---
  function renderList(shoppingList) {
    const discountRow = document.getElementById('calc-discount-row');
    const discountPctRow = document.getElementById('calc-discount-pct-row');
    const discountSalvageEl = document.getElementById('calc-discount-salvage');
    const discountIntelEl = document.getElementById('calc-discount-intel');
    const discountPctSalvageEl = document.getElementById('calc-discount-pct-salvage');
    const discountPctIntelEl = document.getElementById('calc-discount-pct-intel');

    if (shoppingList.length === 0) {
      emptyState.style.display = 'block';
      table.style.display = 'none';
      tbody.innerHTML = '';
      totalSalvageEl.textContent = '-';
      totalIntelEl.textContent = '-';
      discountRow.style.display = 'none';
      discountPctRow.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    table.style.display = 'table';

    let grandSalvage = 0;
    let grandIntel = 0;
    let grandStdSalvage = 0;
    let grandStdIntel = 0;

    tbody.innerHTML = shoppingList.map(item => {
      const { salvage, intel, standardSalvage, standardIntel } = calculatorStore.calculateRowCost(item);
      grandSalvage += salvage;
      grandIntel += intel;
      grandStdSalvage += standardSalvage;
      grandStdIntel += standardIntel;

      const hasWeek = !!calculatorStore.activeWeek;
      const discCell = !hasWeek
        ? `<span class="disc-none">—</span>`
        : item.discountOn
          ? `<button class="disc-toggle-btn disc-yes" data-action="disc-toggle" data-id="${item.instanceId}" title="Buying at discount — click to toggle">✓</button>`
          : `<button class="disc-toggle-btn disc-no" data-action="disc-toggle" data-id="${item.instanceId}" title="Not discounted — click to toggle">✗</button>`;

      const salvageStr = salvage > 0 ? salvage.toLocaleString() : '—';
      const intelStr = intel > 0 ? intel.toLocaleString() : '—';

      const fromSelect = makeLevelSelect('from', item.fromLvl, 1, item.toLvl - 1, item.instanceId);
      const toSelect = makeLevelSelect('to', item.toLvl, item.fromLvl + 1, 13, item.instanceId);

      return `<tr data-instance="${item.instanceId}">
        <td class="module-col">
          <div class="module-col-inner">
            ${item.iconSrc ? `
              <div class="search-result-icon" style="${item.bgSrc ? `background-image: url('${item.bgSrc}');` : ''}">
                <img src="${item.iconSrc}" alt="" />
              </div>
            ` : ''}
            <span class="module-col-name">${item.name}</span>
          </div>
        </td>
        <td class="qty-col" data-label="Qty">
          <button class="qty-btn" data-action="minus" data-id="${item.instanceId}">−</button>
          ${item.quantity}
          <button class="qty-btn" data-action="plus" data-id="${item.instanceId}">+</button>
        </td>
        <td data-label="From">${fromSelect}</td>
        <td data-label="To">${toSelect}</td>
        <td data-label="Disc">${discCell}</td>
        <td class="cost-cell" data-label="Salvage">${salvageStr}</td>
        <td class="cost-cell" data-label="Intel">${intelStr}</td>
      </tr>`;
    }).join('');

    totalSalvageEl.textContent = grandSalvage > 0 ? grandSalvage.toLocaleString() : '—';
    totalIntelEl.textContent = grandIntel > 0 ? grandIntel.toLocaleString() : '—';

    const savedSalvage = grandStdSalvage - grandSalvage;
    const savedIntel = grandStdIntel - grandIntel;
    
    if (savedSalvage > 0 || savedIntel > 0) {
      discountRow.style.display = 'table-row';
      discountPctRow.style.display = 'table-row';
      discountSalvageEl.textContent = savedSalvage > 0 ? `-${savedSalvage.toLocaleString()}` : '—';
      discountIntelEl.textContent = savedIntel > 0 ? `-${savedIntel.toLocaleString()}` : '—';

      discountPctSalvageEl.textContent = grandStdSalvage > 0 && savedSalvage > 0
        ? `(${Math.round((savedSalvage / grandStdSalvage) * 100)}% off)`
        : '—';
      discountPctIntelEl.textContent = grandStdIntel > 0 && savedIntel > 0
        ? `(${Math.round((savedIntel / grandStdIntel) * 100)}% off)`
        : '—';
    } else {
      discountRow.style.display = 'none';
      discountPctRow.style.display = 'none';
    }
  }

  // --- Store event ---
  calculatorStore.addEventListener('change', (e) => {
    const { shoppingList, isOpen, income, weeklyIncome } = e.detail;

    if (isOpen) {
      drawer.classList.add('is-open');
    } else {
      drawer.classList.remove('is-open');
    }

    renderList(shoppingList);

    // Keep income inputs in sync (e.g. after Clear resets them) without
    // clobbering the field the user is actively typing in.
    if (income) {
      if (document.activeElement !== incomeImpactEl) incomeImpactEl.value = income.avgImpact || '';
      if (document.activeElement !== incomePremiumGamesEl) incomePremiumGamesEl.value = income.premiumGames ?? '';
      if (document.activeElement !== incomeFreeGamesEl) incomeFreeGamesEl.value = income.freeGames ?? '';
      if (document.activeElement !== incomeDailiesEl) incomeDailiesEl.value = income.dailiesPerWeek ?? '';
      if (document.activeElement !== incomeWeeklyJobsEl) incomeWeeklyJobsEl.value = income.weeklyJobsPerWeek ?? '';
      if (document.activeElement !== incomeRateEl && document.activeElement !== incomeRateSelectEl) {
        reflectRate(income.creditToSalvage);
      }
    }
    if (weeklyIncome) {
      incomeJobsSalvageEl.textContent = weeklyIncome.jobs.salvage.toLocaleString();
      incomeJobsIntelEl.textContent = weeklyIncome.jobs.intel.toLocaleString();
      incomeMatchesSalvageEl.textContent = weeklyIncome.matches.salvage.toLocaleString();
      incomeTotalSalvageEl.textContent = weeklyIncome.salvage.toLocaleString();
      incomeTotalIntelEl.textContent = weeklyIncome.intel.toLocaleString();
    }
  });

  // --- Delegation: qty buttons + level selects ---
  closeBtn.addEventListener('click', () => {
    calculatorStore.toggleDrawer(false);
  });
  clearBtn.addEventListener('click', () => calculatorStore.clearList());

  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('.qty-btn');
    if (btn) {
      const action = btn.dataset.action;
      const id = btn.dataset.id;
      if (action === 'plus') calculatorStore.updateQuantity(id, 1);
      else if (action === 'minus') calculatorStore.updateQuantity(id, -1);
      return;
    }

    const discBtn = e.target.closest('[data-action="disc-toggle"]');
    if (discBtn) {
      calculatorStore.toggleItemDiscount(discBtn.dataset.id);
    }
  });

  tbody.addEventListener('change', (e) => {
    const sel = e.target.closest('.level-select');
    if (!sel) return;
    const id = sel.dataset.id;
    const type = sel.dataset.lvlType;
    const val = parseInt(sel.value, 10);
    if (type === 'from') calculatorStore.updateItem(id, { fromLvl: val });
    else if (type === 'to') calculatorStore.updateItem(id, { toLvl: val });
  });

  // Initial render
  setTimeout(() => calculatorStore.emitChange(), 0);

  // --- window.addModuleToCalc with batch-session logic ---
  // Defined here (not in the store module) so it's guaranteed to use
  // the exact same calculatorStore instance as the listener above.
  {
    const BATCH_MS = 30_000;
    let batchActive = false;
    let batchTimer = null;

    window.addModuleToCalc = (id, name, iconSrc, bgSrc, rarityRef) => {
      calculatorStore.addItem({ id, name, iconSrc, bgSrc, rarityRef });

      if (!batchActive) {
        calculatorStore.toggleDrawer(true);
      }

      batchActive = true;
      clearTimeout(batchTimer);
      batchTimer = setTimeout(() => { batchActive = false; }, BATCH_MS);
    };
  }
</script>
