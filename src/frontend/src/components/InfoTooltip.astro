---
// Small accessible "?" info tooltip. Shows on hover and keyboard focus/tap.
const { text, label = 'More information' } = Astro.props;
---

<span class="info-tooltip" tabindex="0" role="note" aria-label={label}>
	<span class="info-tooltip__icon" aria-hidden="true">?</span>
	<span class="info-tooltip__bubble">{text}</span>
</span>

<style>
	.info-tooltip {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.12);
		color: var(--wrf-text-muted);
		font-size: 0.62rem;
		font-weight: 700;
		cursor: help;
		vertical-align: middle;
	}

	.info-tooltip__icon {
		line-height: 1;
	}

	.info-tooltip__bubble {
		/* Fixed positioning lets the bubble escape any `overflow: hidden`
		   ancestor (e.g. the rounded `.week-block` card that otherwise shears
		   it off). The script below sets top/left on reveal to anchor it above
		   the icon; --tt-shift nudges it back inside the viewport near an edge. */
		position: fixed;
		top: 0;
		left: 0;
		transform: translate(calc(-50% + var(--tt-shift, 0px)), calc(-100% - 8px));
		width: max-content;
		max-width: 220px;
		padding: 0.5rem 0.65rem;
		background: rgba(15, 17, 21, 0.98);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		color: var(--wrf-text);
		font-size: 0.72rem;
		font-weight: 500;
		line-height: 1.35;
		text-align: left;
		/* The tooltip is often nested inside uppercase labels; keep its own copy
		   in normal sentence case so it does not read as shouting. */
		text-transform: none;
		letter-spacing: normal;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease, visibility 0.15s ease;
		z-index: 1000;
		pointer-events: none;
	}

	.info-tooltip:hover .info-tooltip__bubble,
	.info-tooltip:focus .info-tooltip__bubble,
	.info-tooltip:focus-visible .info-tooltip__bubble {
		opacity: 1;
		visibility: visible;
	}
</style>

<script>
	// The bubble is position:fixed so it escapes any `overflow: hidden` ancestor.
	// On each reveal we anchor it above the icon and shift it back inside the
	// viewport if it would run off an edge. Astro bundles this module once
	// regardless of how many InfoTooltips render.
	const MARGIN = 8;

	function placeBubble(tip: Element) {
		const bubble = tip.querySelector<HTMLElement>('.info-tooltip__bubble');
		if (!bubble) return;
		// Anchor: centered horizontally over the icon, sitting just above it.
		const icon = tip.getBoundingClientRect();
		bubble.style.setProperty('--tt-shift', '0px');
		bubble.style.left = `${icon.left + icon.width / 2}px`;
		bubble.style.top = `${icon.top}px`;
		// Now measure and pull back inside the viewport if it overflows an edge.
		const rect = bubble.getBoundingClientRect();
		let shift = 0;
		if (rect.right > window.innerWidth - MARGIN) {
			shift = -(rect.right - (window.innerWidth - MARGIN));
		} else if (rect.left < MARGIN) {
			shift = MARGIN - rect.left;
		}
		if (shift !== 0) bubble.style.setProperty('--tt-shift', `${shift}px`);
	}

	function handle(e: Event) {
		const target = e.target as Element | null;
		const tip = target?.closest?.('.info-tooltip');
		if (tip) placeBubble(tip);
	}

	// mouseover/focusin both bubble, so a single delegated listener covers every
	// tooltip on the page, including any added later.
	document.addEventListener('mouseover', handle);
	document.addEventListener('focusin', handle);
</script>
