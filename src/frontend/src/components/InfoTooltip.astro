---
// Small accessible "?" info tooltip. Its look, bubble and positioning come from
// the shared design system (.wrf-tooltip in the WRFrontiersDB-Design submodule's
// elements.css, placed by the mirrored wrf-tooltip.js).
const { text, label = 'More information' } = Astro.props;
---

<span class="wrf-tooltip" tabindex="0" role="note" aria-label={label}>
	<span class="wrf-tooltip__icon" aria-hidden="true">?</span>
	<span class="wrf-tooltip__bubble">{text}</span>
</span>

<style>
	/* Look and positioning are shared (.wrf-tooltip); keep only inline alignment
	   with the surrounding label text. */
	.wrf-tooltip {
		vertical-align: middle;
	}
</style>

<script>
	// Shared tooltip placer - mirrored in each repo (canonical source in the
	// WRFrontiersDB-Design README). Astro bundles it once regardless of how many
	// InfoTooltips render.
	import '../scripts/wrf-tooltip.js';
</script>
