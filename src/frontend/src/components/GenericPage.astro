---
import Footer from './Footer.astro';
import '../../vendor/wrf-design/index.css';

const {
	title,
	description,
	baseUrl,
	// og:image is keyed by a base name; the CI build renames the captured PNG to
	// `<ogImage>-<sha>.png` for cache-busting (see .github/actions/build).
	ogImage = 'discount-table',
	ogImageWidth = 1400,
	ogImageHeight = 900,
	ogImageAlt = 'WRF Upgrade Discounts table',
} = Astro.props;

const imageSha = import.meta.env.PUBLIC_IMAGE_SHA;
const imageFilename = imageSha ? `${ogImage}-${imageSha}.png` : `${ogImage}.png`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href={`${baseUrl}global.css`}/>

		<!-- Open Graph / Discord Embed -->
		<meta property="og:title" content={title} />
		<meta name="description" content={description} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={`https://surxe.github.io/WRFrontiers-Discount-Visualizer/${imageFilename}`} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`https://surxe.github.io/WRFrontiers-Discount-Visualizer/${imageFilename}`} />
	</head>
	<body>
		<div class="app-content">
			<slot />
		</div>
		<slot name="bottom-nav" />
		<Footer baseUrl={baseUrl} />
	</body>
</html>

<style>
	body {
		background-color: var(--wrf-bg);
		color: var(--wrf-text);
		font-family: 'Montserrat', sans-serif;
		margin: 0;
		padding: 0;
	}

	.app-content {
		flex: 1 0 auto;
		min-height: 100vh;
		box-sizing: border-box;
		padding: 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
		text-align: center;
	}

	h2 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	@media (max-width: 768px) {
		.app-content {
			padding: calc(1rem + 48px) 1rem calc(1rem + 64px) 1rem;
		}

		h1 {
			font-size: 1.65rem;
		}

		h2 {
			font-size: 1.25rem;
		}
	}
</style>
