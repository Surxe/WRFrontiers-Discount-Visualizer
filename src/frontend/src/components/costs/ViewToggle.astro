---
/**
 * Visual / Table view switcher for the Upgrade Costs page.
 *
 * Behavioural contract: this toggles the sibling sections `#view-visual` and
 * `#view-table` (which live in the page, not this component) and persists the
 * choice under localStorage key `wrf-costs-view`.
 */
---

<div class="view-toggle wrf-toggle" role="tablist" aria-label="View mode">
  <button id="btn-visual" class="wrf-toggle__btn active" role="tab" aria-selected="true">Visual</button>
  <button id="btn-table" class="wrf-toggle__btn" role="tab" aria-selected="false">Table</button>
</div>

<script>
  const btnVisual = document.getElementById('btn-visual');
  const btnTable = document.getElementById('btn-table');
  const viewVisual = document.getElementById('view-visual');
  const viewTable = document.getElementById('view-table');

  function show(mode: 'visual' | 'table') {
    const isVisual = mode === 'visual';
    viewVisual!.hidden = !isVisual;
    viewTable!.hidden = isVisual;
    btnVisual!.classList.toggle('active', isVisual);
    btnTable!.classList.toggle('active', !isVisual);
    btnVisual!.setAttribute('aria-selected', String(isVisual));
    btnTable!.setAttribute('aria-selected', String(!isVisual));
    try { localStorage.setItem('wrf-costs-view', mode); } catch (e) {}
  }

  btnVisual?.addEventListener('click', () => show('visual'));
  btnTable?.addEventListener('click', () => show('table'));

  try {
    const saved = localStorage.getItem('wrf-costs-view');
    if (saved === 'table') show('table');
  } catch (e) {}
</script>

<style>
  /* Visual style comes from the shared .wrf-toggle (elements.css); this only
     centers the control and sets its bottom margin. Higher specificity than the
     shared .wrf-toggle so display:flex wins for margin-auto centering. */
  .view-toggle.wrf-toggle {
    display: flex;
    margin: 0 auto 2rem;
  }
</style>
