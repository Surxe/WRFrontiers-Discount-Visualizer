---
import GenericPage from '../components/GenericPage.astro';
import NavBar from '../components/NavBar.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PredictionList from '../components/PredictionList.astro';
import AllWeeksSidebar from '../components/AllWeeksSidebar.astro';
import { fetchPredictions } from '../utils/predictions.js';
import { fetchWeeksManifest } from '../utils/weeksManifest.js';

const baseUrl = /** @type {string} */ ((import.meta as any).env?.BASE_URL) || '/';
const predictions = fetchPredictions();
const weeks = fetchWeeksManifest();

const dateRange = predictions?.predictedWeek?.label ?? null;
const predictedHref = dateRange ? `${baseUrl}predictions` : null;
const bots = predictions?.bots ?? [];
const titans = predictions?.titans ?? [];

const pct = (v: number | undefined) =>
	v == null ? null : `${Math.round(v * 100)}%`;

// Headline accuracy figures (recomputed from full history on every build).
const botsAtLeastOneTop3 = pct(predictions?.accuracy?.bots?.at_least_one?.['3']);

// Titans are discounted in only a minority of weeks, so their odds are framed
// conditionally ("of the next titan discount, the odds it's this one"). Surface
// how often no titan is discounted at all.
const titanPresence = predictions?.accuracy?.titans?.presence_rate;
const titanNoneRate = titanPresence == null ? null : `${Math.round((1 - titanPresence) * 100)}%`;

// The list is ordered by likelihood, so the "weeks since" values are not in
// order -- a much longer wait does not mean a higher chance. Explain gently.
const botOddsTooltip =
	'Ordered by likelihood, not by how long each bot has waited. A bot that is very overdue is often one that rarely gets discounted, so a longer wait does not always mean a higher chance.';

// Shareable summary, assembled at build time from the same predictions object.
// Copied to the clipboard by the "Copy to share" button below.
const SITE_ORIGIN = 'https://surxe.github.io';
const shareUrl = `${SITE_ORIGIN}${baseUrl}predictions`.replace(/([^:])\/\/+/g, '$1/');
// likelihood_pct is stored 0-100.
const withPct = (b: any) =>
	b?.likelihood_pct == null ? b?.name : `${b.name} (${Math.round(b.likelihood_pct)}%)`;
const topBots = bots.slice(0, 3).filter((b) => b?.name);
const topTitanName = titans?.[0]?.name ?? null;
const shareLines = [
	dateRange ? `WRF discount predictions for ${dateRange}:` : 'WRF discount predictions:',
];
if (topBots.length) shareLines.push(`Robots: ${topBots.map(withPct).join(', ')}`);
// Titans aren't discounted every week, so this is framed as the next titan
// discount rather than tied to a specific week.
if (topTitanName) shareLines.push(`Next titan: ${topTitanName}`);
// Wrapped in <> so chat clients (Discord) don't expand a link embed.
shareLines.push(`<${shareUrl}>`);
const shareText = shareLines.join('\n');
---

<GenericPage
	title="Predictions - WRF Discounts"
	description="Predicted upcoming Mech and Titan discounts, with historical accuracy."
	baseUrl={baseUrl}
	ogImage="predictions-og"
	ogImageWidth={1200}
	ogImageHeight={630}
	ogImageAlt="Predicted upcoming WRF Robot and Titan discounts"
>
	<AllWeeksSidebar
		weeks={weeks}
		currentSlug={null}
		baseUrl={baseUrl}
		predictedLabel={dateRange}
		predictedHref={predictedHref}
		predictedActive={true}
	>
	<MobileTopBar showSidebarToggle={true} showCalcToggle={false} title="WRF Predictions" />
	<NavBar baseUrl={baseUrl} currentPage="predictions" />

	<div class="predictions-page">
		<header class="predictions-header">
			<h1>Discount Predictions</h1>
			{dateRange ? (
				<p class="predicted-range">
					Predicted discounts for <strong>{dateRange}</strong>
				</p>
			) : (
				<p class="predicted-range">Predictions are not available yet.</p>
			)}
			<p class="predicted-note">
				This is the next discount period after the most recently published one.
				Because each week's discounts are revealed up to a week early, this
				may be up to two weeks away.
			</p>
			<p class="estimate-note">
				These are statistical estimates based on past discount patterns — not
				official announcements.
			</p>
			<a class="history-link" href={`${baseUrl}history`}>
				See how past predictions did &rarr;
			</a>
			<a class="method-link" href={`${baseUrl}methodology`}>
				How these are calculated &rarr;
			</a>
			{predictions && (
				<button type="button" id="share-button" class="share-button" aria-live="polite">
					<svg class="share-button__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
						<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
					</svg>
					<span class="share-button__label">Copy to share</span>
				</button>
			)}
		</header>

		{predictions && (
			<div class="prediction-sections">
				<PredictionList
					heading="Robots — most likely to be discounted"
					bots={bots}
					baseUrl={baseUrl}
					oddsTooltip={botOddsTooltip}
				>
					<Fragment slot="disclaimer">
						{botsAtLeastOneTop3 && (
							<>
								Historically, there is a <strong>{botsAtLeastOneTop3}</strong>{' '}
								chance at least one of the top 3 is discounted.{' '}
							</>
						)}
						Robots discounted fewer than 2 times are excluded, as they
						have no established cadence to predict from.
					</Fragment>
				</PredictionList>

				<PredictionList
					heading="Titans — odds of being the next titan discounted"
					bots={titans}
					baseUrl={baseUrl}
					oddsLabel="if a titan"
				>
					<Fragment slot="disclaimer">
						These are the odds of the next titan discount being each titan.
						{titanNoneRate && (
							<> Note that no titan is discounted in about{' '}
							<strong>{titanNoneRate}</strong> of weeks, so the next titan
							discount may not be next week.</>
						)}
					</Fragment>
				</PredictionList>
			</div>
		)}
	</div>
	</AllWeeksSidebar>

	<MobileBottomNav baseUrl={baseUrl} currentPage="predictions" slot="bottom-nav" />
</GenericPage>

<script define:vars={{ shareText }}>
	const btn = document.getElementById('share-button');
	if (btn) {
		const label = btn.querySelector('.share-button__label');
		const original = label ? label.textContent : '';
		let resetTimer;

		async function copyShareText() {
			try {
				if (navigator.clipboard && navigator.clipboard.writeText) {
					await navigator.clipboard.writeText(shareText);
					return true;
				}
			} catch (e) { /* fall through to legacy path */ }

			// Fallback for browsers without the async clipboard API (or non-secure contexts).
			try {
				const ta = document.createElement('textarea');
				ta.value = shareText;
				ta.setAttribute('readonly', '');
				ta.style.position = 'absolute';
				ta.style.left = '-9999px';
				document.body.appendChild(ta);
				ta.select();
				const ok = document.execCommand('copy');
				document.body.removeChild(ta);
				return ok;
			} catch (e) {
				return false;
			}
		}

		btn.addEventListener('click', async () => {
			const ok = await copyShareText();
			if (label) label.textContent = ok ? 'Copied!' : 'Press Ctrl+C to copy';
			btn.classList.remove('is-copied', 'is-error');
			btn.classList.add(ok ? 'is-copied' : 'is-error');
			clearTimeout(resetTimer);
			resetTimer = setTimeout(() => {
				if (label) label.textContent = original;
				btn.classList.remove('is-copied', 'is-error');
			}, 1800);
		});
	}
</script>

<style>
	.predictions-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 5.5rem 1rem 5rem;
	}

	.predictions-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.predictions-header h1 {
		margin-bottom: 0.5rem;
	}

	.predicted-range {
		font-size: 1.15rem;
		color: var(--text-color, #e0e0e0);
		margin: 0.25rem 0;
	}

	.predicted-range strong {
		color: var(--accent-color, #3a86ff);
	}

	.predicted-note {
		font-size: 0.85rem;
		color: var(--text-muted, #8b92a5);
		max-width: 560px;
		margin: 0.5rem auto 0;
		line-height: 1.4;
	}

	.estimate-note {
		font-size: 0.8rem;
		font-style: italic;
		color: var(--text-muted, #8b92a5);
		max-width: 560px;
		margin: 0.6rem auto 0;
		line-height: 1.4;
	}

	.history-link {
		display: inline-block;
		margin-top: 0.7rem;
		font-size: 0.85rem;
		color: var(--accent-color, #3a86ff);
		text-decoration: none;
	}

	.history-link:hover {
		text-decoration: underline;
	}

	.method-link {
		display: block;
		width: fit-content;
		margin: 0.35rem auto 0;
		font-size: 0.85rem;
		color: var(--accent-color, #3a86ff);
		text-decoration: none;
	}

	.method-link:hover {
		text-decoration: underline;
	}

	.share-button {
		display: flex;
		width: fit-content;
		align-items: center;
		gap: 0.4rem;
		margin: 1rem auto 0;
		padding: 0.45rem 0.9rem;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-color, #e0e0e0);
		background: #232733;
		border: 1px solid #333;
		border-radius: 8px;
		cursor: pointer;
		transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
	}

	.share-button:hover {
		background-color: var(--active-bg, rgba(58, 134, 255, 0.1));
		color: var(--accent-color, #3a86ff);
		border-color: var(--accent-color, #3a86ff);
	}

	.share-button.is-copied {
		color: #2ec4b6;
		border-color: #2ec4b6;
		background-color: rgba(46, 196, 182, 0.1);
	}

	.share-button.is-error {
		color: #ff9f1c;
		border-color: #ff9f1c;
		background-color: rgba(255, 159, 28, 0.1);
	}

	.share-button__icon {
		flex-shrink: 0;
	}

	.prediction-sections {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@media (max-width: 768px) {
		.predictions-page {
			padding-top: 4.5rem;
		}
	}
</style>
