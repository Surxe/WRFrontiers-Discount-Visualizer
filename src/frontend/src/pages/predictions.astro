---
import GenericPage from '../components/GenericPage.astro';
import NavBar from '../components/NavBar.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PredictionList from '../components/PredictionList.astro';
import { fetchPredictions } from '../utils/predictions.js';

const baseUrl = /** @type {string} */ ((import.meta as any).env?.BASE_URL) || '/';
const predictions = fetchPredictions();

const dateRange = predictions?.predictedWeek?.label ?? null;
const bots = predictions?.bots ?? [];
const titans = predictions?.titans ?? [];

const pct = (v: number | undefined) =>
	v == null ? null : `${Math.round(v * 100)}%`;

// Headline accuracy figures (recomputed from full history on every build).
const botsAtLeastOneTop3 = pct(predictions?.accuracy?.bots?.at_least_one?.['3']);
const titansAtLeastOne = pct(
	predictions?.accuracy?.titans?.at_least_one?.[String(titans.length)],
);
---

<GenericPage
	title="Predictions - WRF Discounts"
	description="Predicted upcoming Mech and Titan discounts, with historical accuracy."
	baseUrl={baseUrl}
>
	<MobileTopBar showSidebarToggle={false} showCalcToggle={false} title="WRF Predictions" />
	<NavBar baseUrl={baseUrl} currentPage="predictions" />

	<div class="predictions-page">
		<header class="predictions-header">
			<h1>Discount Predictions</h1>
			{dateRange ? (
				<p class="predicted-range">
					Predicted discounts for <strong>{dateRange}</strong>
				</p>
			) : (
				<p class="predicted-range">Predictions are not available yet.</p>
			)}
			<p class="predicted-note">
				This is the next discount period after the most recently published one.
				Because each week's discounts are revealed up to a week early, this range
				may be up to about two weeks away.
			</p>
		</header>

		{predictions && (
			<div class="prediction-sections">
				<PredictionList
					heading="Robots — most likely to be discounted"
					bots={bots}
					baseUrl={baseUrl}
				>
					<Fragment slot="disclaimer">
						{botsAtLeastOneTop3 && (
							<>
								Historically, there is a <strong>{botsAtLeastOneTop3}</strong>{' '}
								chance at least one of the top 3 below is discounted.
							</>
						)}
					</Fragment>
				</PredictionList>

				<PredictionList
					heading="Titans — most likely to be discounted"
					bots={titans}
					baseUrl={baseUrl}
				>
					<Fragment slot="disclaimer">
						{titansAtLeastOne && (
							<>
								Historically, there is a <strong>{titansAtLeastOne}</strong>{' '}
								chance at least one of these {titans.length} is discounted.
							</>
						)}
					</Fragment>
				</PredictionList>
			</div>
		)}
	</div>

	<MobileBottomNav baseUrl={baseUrl} currentPage="predictions" slot="bottom-nav" />
</GenericPage>

<style>
	.predictions-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 5.5rem 1rem 5rem;
	}

	.predictions-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.predictions-header h1 {
		margin-bottom: 0.5rem;
	}

	.predicted-range {
		font-size: 1.15rem;
		color: var(--text-color, #e0e0e0);
		margin: 0.25rem 0;
	}

	.predicted-range strong {
		color: var(--accent-color, #3a86ff);
	}

	.predicted-note {
		font-size: 0.85rem;
		color: var(--text-muted, #8b92a5);
		max-width: 560px;
		margin: 0.5rem auto 0;
		line-height: 1.4;
	}

	.prediction-sections {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@media (max-width: 768px) {
		.predictions-page {
			padding-top: 4.5rem;
		}
	}
</style>
