---
import GenericPage from '../components/GenericPage.astro';
import NavBar from '../components/NavBar.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PredictionWeekBlock from '../components/PredictionWeekBlock.astro';
import AllWeeksSidebar from '../components/AllWeeksSidebar.astro';
import { fetchWeeksManifest } from '../utils/weeksManifest.js';
import { fetchPredictionHistoryIndex, fetchPredictionSnapshot } from '../utils/predictionHistory.js';

const baseUrl = /** @type {string} */ ((import.meta as any).env?.BASE_URL) || '/';
const weeks = fetchWeeksManifest();
const { scoreboard, weeks: rows } = fetchPredictionHistoryIndex();

// Load each week's frozen snapshot at build time (SSG). Newest first, matching
// the index order.
const snapshots = rows
	.map((row: any) => ({ row, snap: fetchPredictionSnapshot(row.file) }))
	.filter((s: any) => s.snap);

const pct = (v: number | undefined | null) =>
	v == null ? null : `${Math.round(v * 100)}%`;

const windowWeeks = scoreboard?.window_weeks;
const boardRate = pct(scoreboard?.bots_rate);
const boardHits = scoreboard?.bots_hits;
const boardWeeks = scoreboard?.bots_scored_weeks;
const titanRate = pct(scoreboard?.titans_rate);
const titanHits = scoreboard?.titans_hits;
const titanWeeks = scoreboard?.titans_scored_weeks;
---

<GenericPage
	title="Prediction History - WRF Discounts"
	description="How past WRF discount predictions did, week by week, with a running accuracy scoreboard."
	baseUrl={baseUrl}
>
	<AllWeeksSidebar weeks={weeks} currentSlug={null} baseUrl={baseUrl}>
	<MobileTopBar showSidebarToggle={true} showCalcToggle={false} title="Prediction History" />
	<NavBar baseUrl={baseUrl} currentPage="predictions" />

	<div class="history-page">
		<header class="history-header">
			<h1>Prediction History</h1>
			<p class="history-sub">
				What we predicted each week, frozen at the time, graded against what was
				actually discounted. Each week uses only the history before it.
			</p>
			<a class="back-link" href={`${baseUrl}predictions`}>&larr; Upcoming prediction</a>
		</header>

		{scoreboard && boardWeeks ? (
			<section class="scoreboard">
				<p class="scoreboard__caption">Accuracy over the last {windowWeeks} weeks</p>
				<div class="scoreboard__stats">
					<div class="scoreboard__stat">
						<span class="scoreboard__value">{boardRate}</span>
						<span class="scoreboard__label">
							of weeks, at least 3 of the top 5 predicted robots were discounted
						</span>
						<span class="scoreboard__detail">{boardHits} of {boardWeeks} recent weeks</span>
					</div>
					{titanWeeks ? (
						<div class="scoreboard__stat">
							<span class="scoreboard__value">{titanRate}</span>
							<span class="scoreboard__label">
								of weeks, the top predicted titan was the one discounted, or no
								titan was discounted
							</span>
							<span class="scoreboard__detail">{titanHits} of {titanWeeks} recent weeks</span>
						</div>
					) : null}
				</div>
			</section>
		) : (
			<p class="history-empty">No graded weeks yet.</p>
		)}

		<div class="week-blocks">
			{snapshots.map(({ row, snap }: any, i: number) => (
				<PredictionWeekBlock
					snap={snap}
					baseUrl={baseUrl}
					open={i === 0}
					footer={{ href: `${baseUrl}week/${row.slug}`, text: "See this week's full discounts →" }}
				/>
			))}
		</div>
	</div>
	</AllWeeksSidebar>

	<MobileBottomNav baseUrl={baseUrl} currentPage="predictions" slot="bottom-nav" />
</GenericPage>

<style>
	.history-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 5.5rem 1rem 5rem;
	}

	.history-header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.history-header h1 {
		margin-bottom: 0.5rem;
	}

	.history-sub {
		font-size: 0.9rem;
		color: var(--text-muted, #8b92a5);
		max-width: 620px;
		margin: 0.4rem auto 0;
		line-height: 1.45;
	}

	.back-link {
		display: inline-block;
		margin-top: 0.9rem;
		font-size: 0.85rem;
		color: var(--accent-color, #3a86ff);
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.scoreboard {
		margin-bottom: 2.25rem;
	}

	.scoreboard__caption {
		text-align: center;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.6px;
		color: var(--text-muted, #8b92a5);
		margin: 0 0 0.9rem;
	}

	.scoreboard__stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
	}

	.scoreboard__stat {
		flex: 1 1 240px;
		max-width: 340px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.3rem;
		padding: 1.1rem 1rem;
		background: rgba(22, 25, 32, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
	}

	.scoreboard__value {
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent-color, #3a86ff);
		line-height: 1;
	}

	.scoreboard__label {
		font-size: 0.82rem;
		color: var(--text-color, #e0e0e0);
		line-height: 1.35;
	}

	.scoreboard__detail {
		font-size: 0.75rem;
		color: var(--text-muted, #8b92a5);
	}

	.history-empty {
		text-align: center;
		color: var(--text-muted, #8b92a5);
	}

	.week-blocks {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	@media (max-width: 768px) {
		.history-page {
			padding-top: 4.5rem;
		}
	}
</style>
