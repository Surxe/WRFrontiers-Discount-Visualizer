---
import GenericPage from '../components/GenericPage.astro';
import NavBar from '../components/NavBar.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PredictionCard from '../components/PredictionCard.astro';
import AllWeeksSidebar from '../components/AllWeeksSidebar.astro';
import { fetchWeeksManifest } from '../utils/weeksManifest.js';
import { fetchPredictionHistoryIndex, fetchPredictionSnapshot } from '../utils/predictionHistory.js';

const baseUrl = /** @type {string} */ ((import.meta as any).env?.BASE_URL) || '/';
const weeks = fetchWeeksManifest();
const { scoreboard, weeks: rows } = fetchPredictionHistoryIndex();

// Load each week's frozen snapshot at build time (SSG). Newest first, matching
// the index order.
const snapshots = rows
	.map((row: any) => ({ row, snap: fetchPredictionSnapshot(row.file) }))
	.filter((s: any) => s.snap);

const pct = (v: number | undefined | null) =>
	v == null ? null : `${Math.round(v * 100)}%`;

const windowWeeks = scoreboard?.window_weeks;
const boardRate = pct(scoreboard?.bots_top3_rate);
const boardHits = scoreboard?.bots_top3_hits;
const boardWeeks = scoreboard?.bots_scored_weeks;
const titanRate = pct(scoreboard?.titans_rate);
const titanHits = scoreboard?.titans_hits;
const titanWeeks = scoreboard?.titans_scored_weeks;

// Per-week outcome summary used for the collapsed header badge.
function weekOutcome(snap: any) {
	const insufficientBots = snap?.insufficient_history?.bots;
	if (insufficientBots) return { kind: 'na', label: 'Not enough history' };
	return snap?.result?.bots?.top3_hit
		? { kind: 'hit', label: 'Top 3 hit' }
		: { kind: 'miss', label: 'Top 3 missed' };
}
---

<GenericPage
	title="Prediction History - WRF Discounts"
	description="How past WRF discount predictions did, week by week, with a running accuracy scoreboard."
	baseUrl={baseUrl}
>
	<AllWeeksSidebar weeks={weeks} currentSlug={null} baseUrl={baseUrl}>
	<MobileTopBar showSidebarToggle={true} showCalcToggle={false} title="Prediction History" />
	<NavBar baseUrl={baseUrl} currentPage="predictions" />

	<div class="history-page">
		<header class="history-header">
			<h1>Prediction History</h1>
			<p class="history-sub">
				What we predicted each week, frozen at the time, graded against what was
				actually discounted. Each week uses only the history before it.
			</p>
			<a class="back-link" href={`${baseUrl}predictions`}>&larr; Upcoming prediction</a>
		</header>

		{scoreboard && boardWeeks ? (
			<section class="scoreboard">
				<p class="scoreboard__caption">Accuracy over the last {windowWeeks} weeks</p>
				<div class="scoreboard__stats">
					<div class="scoreboard__stat">
						<span class="scoreboard__value">{boardRate}</span>
						<span class="scoreboard__label">
							of weeks, at least one of the top 3 robots was discounted
						</span>
						<span class="scoreboard__detail">{boardHits} of {boardWeeks} recent weeks</span>
					</div>
					{titanWeeks ? (
						<div class="scoreboard__stat">
							<span class="scoreboard__value">{titanRate}</span>
							<span class="scoreboard__label">
								of weeks, the top predicted titan was the one discounted, or no
								titan was discounted
							</span>
							<span class="scoreboard__detail">{titanHits} of {titanWeeks} recent weeks</span>
						</div>
					) : null}
				</div>
			</section>
		) : (
			<p class="history-empty">No graded weeks yet.</p>
		)}

		<div class="week-blocks">
			{snapshots.map(({ row, snap }: any, i: number) => {
				const outcome = weekOutcome(snap);
				const insufficient = snap?.insufficient_history?.bots;
				const titanResult = snap?.result?.titans;
				return (
					<details class="week-block" open={i === 0}>
						<summary class="week-block__summary">
							<span class="week-block__label">{snap.label}</span>
							<span class:list={["week-block__badge", `is-${outcome.kind}`]}>{outcome.label}</span>
						</summary>

						{insufficient ? (
							<p class="week-block__note">
								Too few prior discounts to make a prediction this early.
							</p>
						) : (
							<div class="week-block__body">
								<h3 class="week-block__heading">Robots predicted</h3>
								{snap?.odds_available && !snap.odds_available.bots && (
									<p class="week-block__hint">
										Odds aren't shown this early — too little history to calibrate
										them yet. Picks are the most overdue robots and are graded normally.
									</p>
								)}
								<ol class="prediction-cards">
									{snap.bots.map((bot: any) => (
										<PredictionCard bot={bot} baseUrl={baseUrl} rank={bot.overdue_rank} hit={bot.hit} />
									))}
								</ol>
								{snap.titans && snap.titans.length > 0 && (
									<>
										<h3 class="week-block__heading">
											Titans predicted
											{titanResult && !titanResult.any_titan && (
												<span class="week-block__sub"> — no titan was discounted</span>
											)}
										</h3>
										<ol class="prediction-cards">
											{snap.titans.map((titan: any) => (
												<PredictionCard bot={titan} baseUrl={baseUrl} rank={titan.overdue_rank} oddsLabel="if a titan" hit={titan.hit} />
											))}
										</ol>
									</>
								)}
								<a class="week-block__link" href={`${baseUrl}week/${row.slug}`}>
									See this week's full discounts &rarr;
								</a>
							</div>
						)}
					</details>
				);
			})}
		</div>
	</div>
	</AllWeeksSidebar>

	<MobileBottomNav baseUrl={baseUrl} currentPage="predictions" slot="bottom-nav" />
</GenericPage>

<style>
	.history-page {
		max-width: 900px;
		margin: 0 auto;
		padding: 5.5rem 1rem 5rem;
	}

	.history-header {
		text-align: center;
		margin-bottom: 1.75rem;
	}

	.history-header h1 {
		margin-bottom: 0.5rem;
	}

	.history-sub {
		font-size: 0.9rem;
		color: var(--text-muted, #8b92a5);
		max-width: 620px;
		margin: 0.4rem auto 0;
		line-height: 1.45;
	}

	.back-link {
		display: inline-block;
		margin-top: 0.9rem;
		font-size: 0.85rem;
		color: var(--accent-color, #3a86ff);
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.scoreboard {
		margin-bottom: 2.25rem;
	}

	.scoreboard__caption {
		text-align: center;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.6px;
		color: var(--text-muted, #8b92a5);
		margin: 0 0 0.9rem;
	}

	.scoreboard__stats {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
	}

	.scoreboard__stat {
		flex: 1 1 240px;
		max-width: 340px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.3rem;
		padding: 1.1rem 1rem;
		background: rgba(22, 25, 32, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
	}

	.scoreboard__value {
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent-color, #3a86ff);
		line-height: 1;
	}

	.scoreboard__label {
		font-size: 0.82rem;
		color: var(--text-color, #e0e0e0);
		line-height: 1.35;
	}

	.scoreboard__detail {
		font-size: 0.75rem;
		color: var(--text-muted, #8b92a5);
	}

	.history-empty {
		text-align: center;
		color: var(--text-muted, #8b92a5);
	}

	.week-blocks {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.week-block {
		background: rgba(22, 25, 32, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		overflow: hidden;
	}

	.week-block__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.1rem;
		cursor: pointer;
		list-style: none;
	}

	.week-block__summary::-webkit-details-marker {
		display: none;
	}

	.week-block__label {
		font-weight: 600;
		font-size: 0.98rem;
	}

	.week-block__badge {
		flex-shrink: 0;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.4px;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
	}

	.week-block__badge.is-hit {
		color: #2ec4b6;
		background: rgba(46, 196, 182, 0.14);
	}

	.week-block__badge.is-miss {
		color: #ff9f1c;
		background: rgba(255, 159, 28, 0.14);
	}

	.week-block__badge.is-na {
		color: var(--text-muted, #8b92a5);
		background: rgba(139, 146, 165, 0.12);
	}

	.week-block__body {
		padding: 0 1.1rem 1.1rem;
	}

	.week-block__heading {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--text-muted, #8b92a5);
		margin: 1rem 0 0.6rem;
	}

	.week-block__sub {
		text-transform: none;
		letter-spacing: 0;
		font-weight: 400;
	}

	.prediction-cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.week-block__note {
		padding: 0 1.1rem 1.1rem;
		font-size: 0.85rem;
		color: var(--text-muted, #8b92a5);
	}

	.week-block__hint {
		margin: 0 0 0.7rem;
		font-size: 0.78rem;
		font-style: italic;
		color: var(--text-muted, #8b92a5);
		line-height: 1.4;
	}

	.week-block__link {
		display: inline-block;
		margin-top: 0.9rem;
		font-size: 0.82rem;
		color: var(--accent-color, #3a86ff);
		text-decoration: none;
	}

	.week-block__link:hover {
		text-decoration: underline;
	}

	@media (max-width: 768px) {
		.history-page {
			padding-top: 4.5rem;
		}
	}
</style>
