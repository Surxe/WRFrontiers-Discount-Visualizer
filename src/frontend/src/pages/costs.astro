---
import GenericPage from '../components/GenericPage.astro';
import NavBar from '../components/NavBar.astro';
import MobileTopBar from '../components/MobileTopBar.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import fs from 'fs';
import path from 'path';

const baseUrl = /** @type {string} */ ((import.meta as any).env?.BASE_URL) || '/';

// --- Load RarityUpgradeCost.json (same resolution strategy as DiscountPage.astro) ---
let rarityUpgradeCosts: Record<string, any> = {};
try {
  const ruPath = [
    path.resolve('../../WRFrontiersDB-Data/current/Objects/RarityUpgradeCost.json'),
    path.resolve('../../../WRFrontiersDB-Data/current/Objects/RarityUpgradeCost.json'),
    path.resolve('public/WRFrontiersDB-Data/current/Objects/RarityUpgradeCost.json'),
  ].find(p => fs.existsSync(p));
  if (ruPath) rarityUpgradeCosts = JSON.parse(fs.readFileSync(ruPath, 'utf-8'));
} catch (e) { console.error('Failed to load RarityUpgradeCost.json', e); }

// Rarity display order + identity color (validated categorical palette, dark surface).
// Rarity is always text-labelled, so colour is a reinforcement, never the sole cue.
const RARITY_META: Record<string, { color: string; order: number }> = {
  Common:   { color: '#8b93a7', order: 0 },
  Uncommon: { color: '#2f9e56', order: 1 },
  Rare:     { color: '#2f7de0', order: 2 },
  Epic:     { color: '#d857a8', order: 3 },
};

const currencyIcon = (currency: string) =>
  `${baseUrl}WRFrontiersDB-Data/textures/WRFrontiers/Content/Sparrow/UI/Textures/Meta/Currency/` +
  (currency === 'intel' ? 'T_IntelLarge.png' : 'T_AlloysLarge.png');

// Parse "OBJID_ModuleRarity::DA_ModuleRarity_Epic.0" -> "Epic"
const rarityName = (ref: string) => {
  const m = /DA_ModuleRarity_([A-Za-z]+)/.exec(ref || '');
  return m ? m[1] : ref;
};

type LevelRow = {
  level: number;
  currency: 'salvage' | 'intel';
  base: number;
  discounted: number | null;
  pctOff: number | null;
};

const rarities = Object.values(rarityUpgradeCosts)
  .map((entry: any) => {
    const name = rarityName(entry.rarity_ref || entry.id);
    const meta = RARITY_META[name] || { color: '#8b93a7', order: 99 };

    const levels: LevelRow[] = [];
    for (let lvl = 1; lvl <= 13; lvl++) {
      const node = entry.costs?.[String(lvl)];
      if (!node) continue;
      const salv = node.salvage || {};
      const intel = node.intel || {};
      const isSalvage = (salv.standard || salv.discounted) ? true
        : (intel.standard || intel.discounted) ? false
        : true;
      const cur = isSalvage ? salv : intel;
      const base = cur.standard ?? 0;
      const discounted = cur.discounted ?? null;
      const pctOff = discounted != null && base > 0
        ? Math.round((1 - discounted / base) * 100)
        : null;
      levels.push({
        level: lvl,
        currency: isSalvage ? 'salvage' : 'intel',
        base,
        discounted,
        pctOff,
      });
    }

    // Per-currency headline savings (levels that actually carry a discount).
    const savingsFor = (currency: 'salvage' | 'intel') => {
      const d = levels.filter(l => l.currency === currency && l.pctOff != null);
      if (d.length === 0) return null;
      const avg = Math.round(d.reduce((s, l) => s + (l.pctOff || 0), 0) / d.length);
      return avg;
    };

    return {
      name,
      color: meta.color,
      order: meta.order,
      levels,
      salvageSavings: savingsFor('salvage'),
      intelSavings: savingsFor('intel'),
    };
  })
  .sort((a, b) => a.order - b.order);

const fmt = (n: number | null) => (n == null ? '—' : n.toLocaleString());
---

<GenericPage
  title="Upgrade Costs - WRF Discounts"
  description="Base and discounted upgrade costs for every rarity and level in War Robots Frontiers."
  baseUrl={baseUrl}
>
  <MobileTopBar showSidebarToggle={false} showCalcToggle={false} title="WRF Upgrade Costs" />
  <NavBar baseUrl={baseUrl} currentPage="costs" />

  <h1>Upgrade Costs</h1>
  <p class="intro">
    Base versus discounted cost to upgrade a module to each level, for every rarity.
    Levels are the <em>destination</em> level of each upgrade step&nbsp;— level&nbsp;1 is the
    initial unlock and is never discounted.
  </p>

  <div class="view-toggle" role="tablist" aria-label="View mode">
    <button id="btn-visual" class="toggle-btn active" role="tab" aria-selected="true">Visual</button>
    <button id="btn-table" class="toggle-btn" role="tab" aria-selected="false">Table</button>
  </div>

  <!-- ============ VISUAL / UX VIEW ============ -->
  <section id="view-visual" class="view">
    <div class="legend" aria-hidden="true">
      <span class="legend-item"><span class="swatch swatch-pay"></span>You pay (discounted)</span>
      <span class="legend-item"><span class="swatch swatch-save"></span>You save</span>
    </div>

    <div class="rarity-grid">
      {rarities.map(r => (
        <article class="rarity-card" style={`--rarity: ${r.color};`}>
          <header class="rarity-head">
            <span class="rarity-dot"></span>
            <h2 class="rarity-name">{r.name}</h2>
            <span class="rarity-savings">
              {r.salvageSavings != null && (
                <span class="savings-chip"><img class="cur-ico" src={currencyIcon('salvage')} alt="Salvage" />{r.salvageSavings}% off</span>
              )}
              {r.intelSavings != null && (
                <span class="savings-chip"><img class="cur-ico" src={currencyIcon('intel')} alt="Intel" />{r.intelSavings}% off</span>
              )}
            </span>
          </header>

          <ul class="level-list">
            {r.levels.map(l => {
              const hasDisc = l.discounted != null && l.base > 0;
              const payPct = hasDisc ? Math.max(2, Math.round((l.discounted! / l.base) * 100)) : 100;
              return (
                <li class="level-row">
                  <span class="lvl-badge">L{l.level}</span>
                  <img class="cur-ico" src={currencyIcon(l.currency)} alt={l.currency} />
                  <div class="bar" role="img"
                    aria-label={hasDisc
                      ? `Level ${l.level}: base ${fmt(l.base)} ${l.currency}, discounted ${fmt(l.discounted)}, ${l.pctOff}% off`
                      : `Level ${l.level}: ${fmt(l.base)} ${l.currency}, no discount`}>
                    <span class="bar-pay" style={`width:${payPct}%`}></span>
                    {hasDisc && <span class="bar-save" style={`width:${100 - payPct}%`}></span>}
                  </div>
                  <span class="vals">
                    {hasDisc ? (
                      <>
                        <span class="v-disc">{fmt(l.discounted)}</span>
                        <span class="v-base">{fmt(l.base)}</span>
                        <span class="v-off">−{l.pctOff}%</span>
                      </>
                    ) : (
                      <>
                        <span class="v-disc">{fmt(l.base)}</span>
                        <span class="v-nodisc">unlock</span>
                      </>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ TABULAR VIEW ============ -->
  <section id="view-table" class="view" hidden>
    <div class="table-responsive">
      <table class="cost-table">
        <thead>
          <tr>
            <th class="sticky-col">Rarity</th>
            <th>Level</th>
            <th>Currency</th>
            <th class="num">Base Cost</th>
            <th class="num">Discounted Cost</th>
            <th class="num">Savings</th>
          </tr>
        </thead>
        <tbody>
          {rarities.map(r => r.levels.map((l, i) => (
            <tr class={i === 0 ? 'rarity-start' : ''}>
              {i === 0 && (
                <td class="sticky-col rarity-cell" rowspan={r.levels.length} style={`--rarity: ${r.color};`}>
                  <span class="rarity-dot"></span>{r.name}
                </td>
              )}
              <td>{l.level}</td>
              <td class="cur-cell">
                <img class="cur-ico" src={currencyIcon(l.currency)} alt="" />
                {l.currency === 'intel' ? 'Intel' : 'Salvage'}
              </td>
              <td class="num">{fmt(l.base)}</td>
              <td class="num">{l.discounted != null ? fmt(l.discounted) : '—'}</td>
              <td class="num">
                {l.pctOff != null
                  ? <span class="off-pill">−{l.pctOff}%</span>
                  : <span class="no-off">—</span>}
              </td>
            </tr>
          )))}
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const btnVisual = document.getElementById('btn-visual');
    const btnTable = document.getElementById('btn-table');
    const viewVisual = document.getElementById('view-visual');
    const viewTable = document.getElementById('view-table');

    function show(mode: 'visual' | 'table') {
      const isVisual = mode === 'visual';
      viewVisual!.hidden = !isVisual;
      viewTable!.hidden = isVisual;
      btnVisual!.classList.toggle('active', isVisual);
      btnTable!.classList.toggle('active', !isVisual);
      btnVisual!.setAttribute('aria-selected', String(isVisual));
      btnTable!.setAttribute('aria-selected', String(!isVisual));
      try { localStorage.setItem('wrf-costs-view', mode); } catch (e) {}
    }

    btnVisual?.addEventListener('click', () => show('visual'));
    btnTable?.addEventListener('click', () => show('table'));

    try {
      const saved = localStorage.getItem('wrf-costs-view');
      if (saved === 'table') show('table');
    } catch (e) {}
  </script>

  <MobileBottomNav baseUrl={baseUrl} currentPage="costs" slot="bottom-nav" />
</GenericPage>

<style>
  .intro {
    max-width: 720px;
    margin: 0 auto 1.5rem;
    text-align: center;
    color: var(--text-muted, #8b92a5);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  /* ---- View toggle ---- */
  .view-toggle {
    display: flex;
    justify-content: center;
    gap: 0;
    margin: 0 auto 2rem;
    width: fit-content;
    background: var(--sidebar-bg, #161920);
    border: 1px solid var(--sidebar-border, #232733);
    border-radius: 999px;
    padding: 0.25rem;
  }

  .toggle-btn {
    background: none;
    border: none;
    color: var(--text-muted, #8b92a5);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 1.4rem;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .toggle-btn:hover { color: var(--text-color, #e0e0e0); }

  .toggle-btn.active {
    color: #fff;
    background: var(--accent-color, #3a86ff);
  }

  /* ---- Shared currency icon ---- */
  .cur-ico {
    width: 16px;
    height: 16px;
    object-fit: contain;
    vertical-align: text-bottom;
    flex-shrink: 0;
  }

  /* ---- Legend ---- */
  .legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    color: var(--text-muted, #8b92a5);
  }

  .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    display: inline-block;
  }

  .swatch-pay { background: #7c869c; }
  .swatch-save { background: #35a95c; }

  /* ---- Rarity cards ---- */
  .rarity-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .rarity-card {
    background: var(--sidebar-bg, #161920);
    border: 1px solid var(--sidebar-border, #232733);
    border-left: 4px solid var(--rarity);
    border-radius: 0.6rem;
    padding: 1rem 1.25rem 1.25rem;
  }

  .rarity-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--sidebar-border, #232733);
    flex-wrap: wrap;
  }

  .rarity-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--rarity);
    flex-shrink: 0;
  }

  .rarity-name {
    margin: 0;
    font-size: 1.15rem;
    color: var(--text-color, #e0e0e0);
  }

  .rarity-savings {
    margin-left: auto;
    display: inline-flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .savings-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #35a95c;
    background: rgba(53, 169, 92, 0.12);
    border: 1px solid rgba(53, 169, 92, 0.3);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .savings-chip .cur-ico { width: 13px; height: 13px; }

  /* ---- Level rows / bars ---- */
  .level-list { list-style: none; margin: 0; padding: 0; }

  .level-row {
    display: grid;
    grid-template-columns: 2.2rem 18px 1fr 8.5rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0;
  }

  .lvl-badge {
    font-family: 'Courier New', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted, #8b92a5);
    text-align: right;
  }

  .bar {
    display: flex;
    height: 14px;
    border-radius: 4px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }

  .bar-pay {
    background: #7c869c;
    border-radius: 4px 0 0 4px;
    min-width: 3px;
  }

  .bar-save {
    background: #35a95c;
    border-radius: 0 4px 4px 0;
    /* 2px surface gap between the two segments */
    margin-left: 2px;
  }

  .vals {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    justify-content: flex-end;
    font-family: 'Courier New', monospace;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .v-disc { color: var(--text-color, #e0e0e0); font-weight: 700; }

  .v-base {
    color: var(--text-muted, #8b92a5);
    text-decoration: line-through;
    font-size: 0.72rem;
  }

  .v-off { color: #35a95c; font-weight: 700; font-size: 0.72rem; }

  .v-nodisc {
    color: var(--text-muted, #8b92a5);
    font-style: italic;
    font-size: 0.72rem;
    font-family: 'Montserrat', sans-serif;
  }

  /* ---- Table view ---- */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cost-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--sidebar-bg, #161920);
    border: 1px solid var(--sidebar-border, #232733);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .cost-table th,
  .cost-table td {
    padding: 0.6rem 0.9rem;
    text-align: left;
    border-bottom: 1px solid var(--sidebar-border, #232733);
  }

  .cost-table th {
    font-weight: 600;
    color: var(--text-muted, #8b92a5);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .cost-table td.num,
  .cost-table th.num {
    text-align: right;
    font-family: 'Courier New', monospace;
  }

  .cur-cell { display: flex; align-items: center; gap: 0.4rem; white-space: nowrap; }

  .rarity-cell {
    font-weight: 700;
    font-size: 1rem;
    vertical-align: middle;
    border-left: 4px solid var(--rarity);
    white-space: nowrap;
  }

  .rarity-cell .rarity-dot {
    display: inline-block;
    margin-right: 0.4rem;
    vertical-align: middle;
  }

  .rarity-start td { border-top: 2px solid var(--sidebar-border, #232733); }

  .off-pill {
    color: #35a95c;
    font-weight: 700;
  }

  .no-off { color: var(--text-muted, #8b92a5); }

  @media (max-width: 768px) {
    .rarity-grid { grid-template-columns: 1fr; }

    .level-row {
      grid-template-columns: 1.9rem 16px 1fr 7rem;
      gap: 0.4rem;
    }

    .vals { font-size: 0.68rem; gap: 0.25rem; }
    .v-base { display: none; }

    .cost-table th,
    .cost-table td { padding: 0.45rem 0.5rem; font-size: 0.78rem; }
  }
</style>
